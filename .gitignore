# Computer Graphics - Academic Repository
# Specialized .gitignore for graphics and scholarly archiving

# OS-generated files
[Tt]humbs.db
[Dd]esktop.ini
.DS_Store
.AppleDouble
.LSOverride

# Editor and IDE configuration
.vscode/
.idea/
*.swp
*.swo
*~
*.iml
*.code-workspace
.vs/

# C/C++ Build Artifacts
*.exe
*.dll
*.so
*.dylib
*.o
*.obj
*.a
*.lib
*.out
bin/
obj/
Debug/
Release/

# Turbo C++ / Borland artifacts
*.dsk
*.tc
*.r
*.sym
*.map

# Python Build Artifacts
__pycache__/
*.py[cod]

# Temporary and Cache files
*.tmp
*.log
.cache/
node_modules/

# Academic build/output artifacts
*.bak
*.sav
*.old
*.orig
